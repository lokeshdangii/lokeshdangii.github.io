<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title or (site.name + " — " + site.role) }}</title>
  <meta name="description" content="{{ description or (site.name + ' — ' + site.role + ' specializing in ' + site.specialization + '.') }}" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content="{{ title or (site.name + ' — ' + site.role) }}" />
  <meta property="og:description" content="{{ description or (site.name + ' — ' + site.role + ' specializing in ' + site.specialization + '.') }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta name="twitter:card" content="summary" />

  <link rel="icon" href="/assets/img/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/style.css" />
</head>
<body>
  <script>
    (function () {
      var saved = localStorage.getItem("selected-theme");
      if (saved === "dark") document.documentElement.classList.add("dark-theme");
      if (saved === "light") document.documentElement.classList.add("light-theme");
    })();
  </script>

  {% include "header.njk" %}

  <main>
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}

  <a href="#top" class="scroll-up" id="scroll-up" aria-label="Scroll to top">↑</a>

  <script src="/assets/js/main.js"></script>
</body>
</html>
